{
    "vtol": {
        "name": "VTOL Scout",
        "port": "COM3",
        "baudrate": 57600,
        "timeout": 5.0,
        "commands": {
            "ping": "PING",
            "arm": "ARM",
            "takeoff": "TAKEOFF",
            "scout": "SCOUT",
            "mode_auto": "MODE:AUTO",
            "rtl": "RTL"
        },
        "acknowledgments": {
            "ping": "PONG",
            "arm": "ACK:ARM",
            "takeoff": "ACK:TAKEOFF",
            "scout": "ACK:SCOUT",
            "mode": "ACK:MODE",
            "rtl": "ACK:RTL"
        }
    },
    "delivery": {
        "name": "Delivery Drone",
        "port": "COM4",
        "baudrate": 57600,
        "timeout": 5.0,
        "default_altitude": 20.0,
        "commands": {
            "ping": "PING",
            "arm": "ARM",
            "takeoff": "TAKEOFF",
            "goto": "GOTO:{lat},{lon},{alt}",
            "rtl": "RTL"
        },
        "acknowledgments": {
            "ping": "PONG",
            "arm": "ACK:ARM",
            "takeoff": "ACK:TAKEOFF",
            "goto": "ACK:GOTO",
            "rtl": "ACK:RTL"
        }
    },
    "detection": {
        "message_format": "DETECTED:{lat},{lon},{timestamp},{confidence}",
        "auto_trigger_delivery": true
    },
    "server": {
        "host": "0.0.0.0",
        "port": 8001,
        "websocket_path": "/ws"
    }
}
